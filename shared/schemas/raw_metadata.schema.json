{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RawMetadata",
  "type": "object",
  "required": ["document_id", "ticker", "cik", "filing_date", "form_type", "source_path"],
  "properties": {
    "document_id": { "type": "string" },
    "ticker": { "type": "string" },
    "cik": { "type": "string" },
    "filing_date": { "type": "string", "format": "date" },
    "form_type": { "type": "string", "const": "10-K" },
    "source_path": { "type": "string" }
  }
}
