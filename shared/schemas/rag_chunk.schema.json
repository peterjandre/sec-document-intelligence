{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RagChunk",
  "type": "object",
  "required": [
    "chunk_id",
    "source_doc_id",
    "section",
    "text",
    "char_range",
    "token_count",
    "metadata",
    "citation_locator"
  ],
  "properties": {
    "chunk_id": { "type": "string" },
    "source_doc_id": { "type": "string" },
    "section": { "type": "string" },
    "text": { "type": "string" },
    "char_range": {
      "type": "array",
      "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
      "minItems": 2,
      "maxItems": 2
    },
    "token_count": { "type": "integer", "minimum": 1 },
    "metadata": { "type": "object" },
    "citation_locator": {
      "type": "object",
      "required": ["document_id", "section"],
      "properties": {
        "document_id": { "type": "string" },
        "section": { "type": "string" }
      }
    }
  }
}
